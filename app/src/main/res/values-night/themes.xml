<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.Evolv" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Colores primarios -->
        <item name="colorPrimary">@color/purple_light</item>
        <item name="colorPrimaryContainer">@color/purple_dark</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        
        <!-- Colores secundarios -->
        <item name="colorSecondary">@color/purple_secondary_light</item>
        <item name="colorSecondaryContainer">@color/purple_secondary_dark</item>
        <item name="colorOnSecondary">@color/on_secondary</item>

        <!-- Colores de superficie -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurface">@color/on_surface_dark</item>
        <item name="android:textColorPrimary">@color/on_primary</item>
        <item name="android:textColorSecondary">@color/on_secondary</item>

        <!-- Colores de estado -->
        <item name="colorError">@color/error_light</item>
        <item name="colorErrorContainer">@color/error</item>
        <item name="android:windowBackground">@color/background</item>
        
        <!-- Configuración del menú overflow -->
        <item name="actionOverflowButtonStyle">@style/Widget.Evolv.Button.Overflow.Night</item>
        <item name="actionOverflowMenuStyle">@style/Widget.Evolv.PopupMenu.Overflow.Night</item>

        <!-- Estilos por defecto -->
        <item name="textInputStyle">@style/Widget.Evolv.TextInputLayout.Night</item>
        <item name="materialButtonStyle">@style/Widget.Evolv.Button.Night</item>
        <item name="popupMenuStyle">@style/Widget.Evolv.PopupMenu.Night</item>
        <item name="android:popupMenuStyle">@style/Widget.Evolv.PopupMenu.Night</item>
        <item name="textAppearancePopupMenuHeader">@style/TextAppearance.Evolv.PopupMenu.Night</item>
        <item name="popupMenuBackground">?attr/colorSurface</item>
        <item name="actionOverflowMenuStyle">@style/Widget.Evolv.PopupMenu.Night</item>
        <item name="android:itemTextAppearance">@style/TextAppearance.Evolv.PopupMenu.Night</item>
        <item name="actionMenuTextColor">@color/on_surface_dark</item>
        <item name="android:spinnerStyle">@style/Widget.Evolv.Spinner.Night</item>
        <item name="android:spinnerDropDownItemStyle">@style/Widget.Evolv.DropDownItem.Night</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Evolv.Dialog.Night</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Evolv.Dialog.Night</item>
        <item name="android:alertDialogTheme">@style/ThemeOverlay.Evolv.Dialog.Night</item>
    </style>
    
    <!-- Estilo para botones en modo nocturno -->
    <style name="Widget.Evolv.Button.Night" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">8dp</item>
        <item name="rippleColor">@color/ripple</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="backgroundTint">@color/purple_dark</item>
    </style>

    <style name="Widget.Evolv.Button.Outlined.Night" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="strokeColor">@color/purple_light</item>
        <item name="rippleColor">@color/ripple</item>
    </style>
    
    <style name="Widget.Evolv.Button.Text.Night" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="rippleColor">@color/ripple</item>
        <item name="android:textColor">@color/on_primary</item>
    </style>
    
    <!-- Estilos para Spinners en modo oscuro -->
    <style name="Widget.Evolv.Spinner.Night" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@color/surface_dark</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:popupBackground">@color/surface_dark</item>
    </style>
    
    <style name="Widget.Evolv.DropDownItem.Night" parent="Widget.AppCompat.DropDownItem.Spinner">
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:background">@color/surface_dark</item>
    </style>
    
    <!-- Estilos para TextViews en modo oscuro -->
    <style name="Widget.Evolv.TextView.Night" parent="Widget.MaterialComponents.TextView">
        <item name="android:textColor">@color/on_primary</item>
    </style>
    
    <!-- Estilos para diálogos en modo oscuro -->
    <style name="ThemeOverlay.Evolv.Dialog.Night" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="android:windowBackground">@color/surface_dark</item>
        <item name="android:colorBackground">@color/surface_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="android:textColorPrimary">@color/on_primary</item>
        <item name="android:textColorSecondary">@color/on_secondary</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Evolv.Button.Text.Night</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Evolv.Button.Text.Night</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Evolv.Button.Text.Night</item>
    </style>
    
    <!-- Estilos para menús en modo nocturno -->
    <style name="Widget.Evolv.PopupMenu.Night" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@color/surface_dark</item>
    </style>
    
    <style name="Widget.Evolv.PopupMenu.Overflow.Night" parent="Widget.Material3.PopupMenu.Overflow">
        <item name="android:popupBackground">@color/surface_dark</item>
    </style>
    
    <style name="TextAppearance.Evolv.PopupMenu.Night" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/on_primary</item>
    </style>
    
    <style name="Widget.Evolv.Button.Overflow.Night" parent="Widget.AppCompat.ActionButton.Overflow">
        <item name="tint">@color/on_surface_dark</item>
    </style>
    
    <!-- Estilo para campos de texto en modo nocturno -->
    <style name="Widget.Evolv.TextInputLayout.Night" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/purple_light</item>
        <item name="android:textColorHint">@color/on_surface_dark</item>
        <item name="hintTextColor">@color/on_primary</item>
        <item name="boxBackgroundColor">@color/surface_dark</item>
        <item name="android:textColor">@color/on_primary</item>
    </style>
</resources>