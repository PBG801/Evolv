<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="?attr/colorSurface">

    <!-- Selector de modo (temporizador vs. repeticiones) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Modo de ejercicio"
        android:textAppearance="?attr/textAppearanceBody1"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"
        style="@style/Widget.Evolv.TextView.Night" />
        
    <RadioGroup
        android:id="@+id/radioGroupMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp"/>

    <!-- Series -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"/>

    <!-- Repeticiones -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_reps"
        android:layout_marginTop="12dp"
        android:textAppearance="?attr/textAppearanceBody1"
        style="@style/Widget.Evolv.TextView.Night" />
    <Spinner
        android:id="@+id/editReps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Tiempo de ejecución -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_execution_time"
        android:layout_marginTop="12dp"
        android:textAppearance="?attr/textAppearanceBody1"
        style="@style/Widget.Evolv.TextView.Night" />
    <Spinner
        android:id="@+id/editDuration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Tiempo de descanso -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/rest_block_placeholder"
        android:layout_marginTop="12dp"
        android:textAppearance="?attr/textAppearanceBody1"
        style="@style/Widget.Evolv.TextView.Night" />
    <Spinner
        android:id="@+id/editRest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
