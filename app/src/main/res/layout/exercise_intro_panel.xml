<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="@android:color/white">

    <TextView
        android:id="@+id/textExerciseIntroTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nombre del ejercicio"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <ImageView
        android:id="@+id/imageExerciseIntro"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_exercise_placeholder"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/textExerciseIntroDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Descripción del ejercicio"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/textExerciseIntroDetails"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Series: 3  Reps: 10  Duración: 30s"
        android:textSize="16sp"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/buttonStartExercise"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Comenzar"
        android:textAllCaps="false"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:textSize="18sp"/>

</LinearLayout>
